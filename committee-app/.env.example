# ฐานข้อมูล Neon (Project > Connection details > Pooled connection)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# รหัสผ่านเข้าระบบ (ข้อมูลมีชื่อบุคคลธรรมดา ห้ามเปิดโดยไม่ตั้งรหัส)
APP_PASSWORD=change-me
# สตริงสุ่มยาวอย่างน้อย 32 ตัวอักษร ใช้เซ็นคุกกี้ (สร้างด้วย: openssl rand -base64 32)
SESSION_SECRET=change-me-to-a-long-random-string

# ไม่บังคับ: ถ้าไม่ตั้ง DATABASE_URL ตอนพัฒนาจะใช้ฐานข้อมูลในเครื่อง (PGlite) ที่ .data/pglite
# PGLITE_DIR=memory
