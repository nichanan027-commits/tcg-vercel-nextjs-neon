{
  "spec_name": "PGS10 Data Dictionary",
  "spec_version": "1.0.0-DRAFT",
  "frozen": false,
  "basis": "PGS10 Claim Audit Master Rules 2026.09.29 (Rulebook 22 Controls) + PGS 10 Master Audit + locked rules L-01..L-14 (02_PGS10_OPERATIONAL_AUDIT_RULES.md)",
  "conventions": {
    "dates": "เก็บภายในเป็น ISO 8601 ปี ค.ศ. (YYYY-MM-DD); รับ/แสดงเป็น พ.ศ. (พ.ศ. = ค.ศ. + 543). ห้ามเก็บปี พ.ศ. ในสตริง ISO (M§29 ตัวอย่างเขียนผิด — A-22)",
    "money": "Decimal เก็บเป็นจำนวนเต็มสตางค์; ห้าม Floating Point",
    "rounding": "ROUND_HALF_UP ที่ 2 ตำแหน่ง ทำครั้งเดียวที่ปลายสูตร (claim_amount)",
    "percent": "เก็บเป็น basis points (70% = 7000)",
    "identifier_rule": "ห้ามแก้ค่าต้นทาง; เก็บทั้ง value และ normalized_value"
  },
  "provenance_schema": {
    "description": "ทุกฟิลด์ที่อ่านจากเอกสารต้องเก็บ",
    "fields": [
      "value",
      "normalized_value",
      "source_document",
      "source_page",
      "page_type(document_page|pdf_page)",
      "document_type",
      "visible_on_rendered_page",
      "bounding_box",
      "extraction_method",
      "confidence",
      "rule_used"
    ]
  },
  "source_priority": [
    "P0 หลักเกณฑ์ PGS 10 ทางการ",
    "P0' Operational Hard Controls ที่ล็อก",
    "P1 เอกสารต้นฉบับของเคส",
    "P2 หน้าจอระบบ",
    "P3 OCR/Text Layer (ค้นหา/ช่วยอ่านเท่านั้น)"
  ],
  "document_types": [
    "APPROVAL_LETTER_OR_CONTRACT",
